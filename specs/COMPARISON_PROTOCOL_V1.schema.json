{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thebrazenbeard/world-zero/specs/COMPARISON_PROTOCOL_V1.schema.json",
  "title": "World Zero Comparison Protocol V1",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_id",
    "claim_id",
    "subjects",
    "calibration_partition_id",
    "holdout_partition_ids",
    "metrics",
    "decision_rules",
    "missing_subject_policy",
    "frozen_before_execution"
  ],
  "properties": {
    "schema_version": {"const": "COMPARISON_PROTOCOL_V1"},
    "protocol_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "purpose": {"type": "string"},
    "subjects": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["subject_id", "subject_class"],
        "properties": {
          "subject_id": {"type": "string"},
          "subject_class": {"type": "string", "enum": ["CAUSAL_FAMILY", "PREDICTIVE_BENCHMARK"]},
          "expected_manifest_digest": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "calibration_partition_id": {"type": "string"},
    "holdout_partition_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["metric_id", "observable_ids", "aggregation", "direction"],
        "properties": {
          "metric_id": {"type": "string"},
          "observable_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "aggregation": {"type": "string", "enum": ["NONE", "MEAN", "MEDIAN", "WEIGHTED_MEAN", "MAX", "CUSTOM_FROZEN"]},
          "direction": {"type": "string", "enum": ["LOWER_IS_BETTER", "HIGHER_IS_BETTER", "WITHIN_RANGE"]},
          "target_range": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
        },
        "additionalProperties": false
      }
    },
    "decision_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rule_id", "rule_type"],
        "properties": {
          "rule_id": {"type": "string"},
          "rule_type": {"type": "string", "enum": ["ABSOLUTE_TOLERANCE", "RELATIVE_TOLERANCE", "DIRECTIONAL_AGREEMENT", "BENCHMARK_MARGIN", "PARETO_NONDOMINANCE", "CUSTOM_FROZEN"]},
          "metric_id": {"type": ["string", "null"]},
          "threshold": {"type": ["number", "null"]},
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "missing_subject_policy": {"type": "string", "enum": ["FAIL_COMPARISON", "DOWNGRADE_TO_EXPLORATORY"]},
    "identifiability_gate_id": {"type": ["string", "null"]},
    "complexity_reporting_required": {"type": "boolean", "default": true},
    "frozen_before_execution": {"type": "boolean"},
    "exploratory": {"type": "boolean", "default": false},
    "notes": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {
        "properties": {"frozen_before_execution": {"const": false}}
      },
      "then": {
        "properties": {"exploratory": {"const": true}}
      }
    }
  ],
  "additionalProperties": false
}
