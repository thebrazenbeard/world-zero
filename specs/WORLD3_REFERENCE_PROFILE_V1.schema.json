{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "WORLD3_REFERENCE_PROFILE_V1.schema.json",
  "title": "World3 Reference Profile V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "variant",
    "role",
    "scenario_id",
    "observable_ids",
    "primary_references"
  ],
  "properties": {
    "schema_version": {"const": "WORLD3_REFERENCE_PROFILE_V1"},
    "profile_id": {"type": "string", "minLength": 1},
    "variant": {"enum": ["WORLD3_1974_DYNAMICS", "WORLD3_03_2004"]},
    "role": {"enum": ["CANONICAL_F0_CONTROL", "COMPATIBILITY_REFERENCE"]},
    "scenario_id": {"enum": ["STANDARD_RUN", "BAU1"]},
    "observable_ids": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "POPULATION",
          "INDUSTRIAL_OUTPUT_PER_CAPITA",
          "FOOD_PER_CAPITA",
          "NONRENEWABLE_RESOURCE_FRACTION",
          "PERSISTENT_POLLUTION_INDEX"
        ]
      }
    },
    "primary_references": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"role": {"const": "CANONICAL_F0_CONTROL"}},
        "required": ["role"]
      },
      "then": {
        "properties": {
          "variant": {"const": "WORLD3_1974_DYNAMICS"},
          "scenario_id": {"const": "STANDARD_RUN"}
        }
      }
    }
  ]
}
