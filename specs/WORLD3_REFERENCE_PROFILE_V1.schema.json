{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "WORLD3_REFERENCE_PROFILE_V1.schema.json",
  "title": "World3 Reference Profile V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "variant",
    "role",
    "start_year",
    "end_year",
    "timestep_years",
    "integration_semantics",
    "observable_ids",
    "primary_references",
    "reference_implementations"
  ],
  "properties": {
    "schema_version": {"const": "WORLD3_REFERENCE_PROFILE_V1"},
    "profile_id": {"type": "string", "minLength": 1},
    "variant": {"enum": ["WORLD3_1974_DYNAMICS", "WORLD3_03_2004"]},
    "role": {"enum": ["CANONICAL_F0_CONTROL", "COMPATIBILITY_REFERENCE"]},
    "start_year": {"type": "integer"},
    "end_year": {"type": "integer"},
    "timestep_years": {"type": "number", "exclusiveMinimum": 0},
    "integration_semantics": {"const": "REFERENCE_BACKWARD_EULER_COMPATIBLE"},
    "observable_ids": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "POPULATION",
          "INDUSTRIAL_OUTPUT_PER_CAPITA",
          "FOOD_PER_CAPITA",
          "NONRENEWABLE_RESOURCE_FRACTION",
          "PERSISTENT_POLLUTION_INDEX"
        ]
      }
    },
    "primary_references": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "reference_implementations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+@[0-9a-f]{40}$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"role": {"const": "CANONICAL_F0_CONTROL"}},
        "required": ["role"]
      },
      "then": {
        "properties": {"variant": {"const": "WORLD3_1974_DYNAMICS"}}
      }
    }
  ]
}
