{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "WORLD3_ORACLE_EXECUTION_V1.schema.json",
  "title": "World3 Oracle Execution V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "oracle_id",
    "profile_id",
    "implementation_ref",
    "start_year",
    "end_year",
    "timestep_years",
    "endpoint_inclusive",
    "sample_count",
    "delay_method",
    "run_mode",
    "constants_mode",
    "tables_mode",
    "initialization_sequence",
    "observable_bindings"
  ],
  "properties": {
    "schema_version": {"const": "WORLD3_ORACLE_EXECUTION_V1"},
    "oracle_id": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "implementation_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+@[0-9a-f]{40}$"
    },
    "start_year": {"type": "integer"},
    "end_year": {"type": "integer"},
    "timestep_years": {"type": "number", "exclusiveMinimum": 0},
    "endpoint_inclusive": {"type": "boolean"},
    "sample_count": {"type": "integer", "minimum": 2},
    "delay_method": {"enum": ["EULER", "IMPLEMENTATION_NATIVE"]},
    "run_mode": {"enum": ["CHECKED_RESCHEDULE", "IMPLEMENTATION_NATIVE"]},
    "constants_mode": {"const": "IMPLEMENTATION_DEFAULTS"},
    "tables_mode": {"const": "IMPLEMENTATION_DEFAULTS"},
    "initialization_sequence": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "observable_bindings": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["observable_id", "implementation_name"],
        "properties": {
          "observable_id": {
            "enum": [
              "POPULATION",
              "INDUSTRIAL_OUTPUT_PER_CAPITA",
              "FOOD_PER_CAPITA",
              "NONRENEWABLE_RESOURCE_FRACTION",
              "PERSISTENT_POLLUTION_INDEX"
            ]
          },
          "implementation_name": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
